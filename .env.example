# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
PUBLIC_API_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:5173

# Leave blank to use the bundled local MongoDB (auto-started, persisted in .data/)
MONGODB_URI=

# Access/refresh signing keys — change for anything beyond local dev
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# ── Media / CDN ───────────────────────────────────────────────────────────
# local = write HLS to ./media and serve it with signed cookies
# s3    = upload to S3 and serve through CloudFront signed cookies
MEDIA_DRIVER=local
MEDIA_OPEN=false

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# ── Queue ─────────────────────────────────────────────────────────────────
# local = in-process worker (single machine demo)
# bullmq = Redis-backed BullMQ queue (production path, run `npm run worker`)
QUEUE_DRIVER=local
REDIS_URL=

# ── Encoding ──────────────────────────────────────────────────────────────
HLS_RENDITIONS=360,720
HLS_SEGMENT_SECONDS=4

# ── Payments ──────────────────────────────────────────────────────────────
# mock = built-in test checkout (no keys needed)
# stripe = Stripe test-mode Checkout + webhook
PAYMENTS_DRIVER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PCT=20

# ── Live classes ──────────────────────────────────────────────────────────
# simulated = local camera preview + realtime chat (no account needed)
# livekit = LiveKit Cloud SFU
LIVE_DRIVER=simulated
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
